<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#f7c600">
    <title>{{ page_title }}{% unless page_title contains shop.name %} | {{ shop.name }}{% endunless %}</title>
    {{ content_for_header }}
    {{ 'spl.css' | asset_url | stylesheet_tag }}
  </head>
  <body>
    {{ content_for_layout }}
    <script src="{{ 'spl.js' | asset_url }}" defer></script>
  </body>
</html>
