# php -- BEGIN cPanel-generated handler, do not edit
# This domain inherits the “PHP” package.
# php -- END cPanel-generated handler, do not edit

# SPL Security Solutions – Apache config for HostPapa cPanel (public_html/.htaccess)
# Generated by scripts/build-hostpapa.cjs – edit hosting/hostpapa/htaccess.template, not the built copy.

Options -Indexes
DirectoryIndex index.html index.php
ErrorDocument 404 /404.html
AddDefaultCharset utf-8

<IfModule mod_rewrite.c>
RewriteEngine On

# --- Form endpoints (contact + Customer Portal quote) -----------------------------
RewriteRule ^api/contact/?$ api/contact.php [L]
RewriteRule ^api/portal-quote/?$ api/portal-quote.php [L]

# --- Old ballinalocksmiths.com.au domain -> spl.com.au (host-scoped; inert until that domain points here) ---
# Runs FIRST so Ballina paths get their own mapping (source: backlink-migration.csv rows for ballinalocksmiths.com.au;
# full URL inventory: hosting/hostpapa/ballina-redirect-map.csv). Catch-all for anything else -> /ballina/.
{{BALLINA}}

# --- 301 redirects: old paths -> final https://{{HOST}} URLs (absolute, one hop) ---
# Runs BEFORE host/HTTPS canonical so renamed paths (door-hardware, locksmiths/24-7-*, …)
# never soft-land on the old path after a naive apex redirect. Source: seo.config.json + backlink-migration.csv
{{REDIRECTS}}


# --- Old splsecurity.com.au domain -> spl.com.au, same path (only if parked/aliased here; unmapped paths)
RewriteCond %{HTTP_HOST} ^(www\.)?splsecurity\.com\.au$ [NC]
RewriteRule ^ https://{{HOST}}%{REQUEST_URI} [R=301,L,NE]

# --- Canonical host + HTTPS (remaining requests) --------------------------------
# ENABLED 29 Oct 2026 cutover: DNS + AutoSSL live. Canonical host: {{HOST}}
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^{{OTHER_HOST_ESC}}$ [NC]
RewriteRule ^ https://{{HOST}}%{REQUEST_URI} [R=301,L,NE]
</IfModule>

# --- Staging: keep search engines out until launch ------------------------------
{{STAGING}}

# --- Security headers ------------------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "geolocation=(), camera=(), microphone=()"
  # Enabled 29 Oct 2026 cutover (HTTPS live on apex + www):
  Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

# Block dotfiles (except .well-known for AutoSSL) and backup/source files
<IfModule mod_rewrite.c>
  RewriteRule (^|/)\.(?!well-known/) - [F]
</IfModule>
<FilesMatch "\.(bak|orig|log|sql|sh|md|cjs|lock)$">
  Require all denied
</FilesMatch>

# --- Compression --------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/javascript application/json application/manifest+json image/svg+xml font/ttf
</IfModule>

# --- Caching ------------------------------------------------------------------------
# HTML revalidates; CSS/JS are versioned with ?v=; images and fonts are long-lived.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/xml "access plus 1 hour"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/manifest+json "access plus 1 week"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(css|js|webp|png|jpe?g|svg|ico|woff2)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
</IfModule>
AddType font/woff2 .woff2
AddType application/manifest+json .webmanifest
AddType image/webp .webp

# --- Sitemap / XML content type (GSC needs application/xml) ---
AddType application/xml .xml
<IfModule mod_headers.c>
  <FilesMatch "^sitemap\.xml$">
    Header always set Content-Type "application/xml; charset=utf-8"
  </FilesMatch>
</IfModule>
