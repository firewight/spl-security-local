# SPL Security Solutions – Apache config for HostPapa cPanel (public_html/.htaccess)
# Generated by scripts/build-hostpapa.cjs – edit hosting/hostpapa/htaccess.template, not the built copy.

Options -Indexes
DirectoryIndex index.html index.php
ErrorDocument 404 /404.html
AddDefaultCharset utf-8

<IfModule mod_rewrite.c>
RewriteEngine On

# --- Canonical host + HTTPS -------------------------------------------------
# ENABLE ONLY AFTER DNS points here AND AutoSSL has issued a certificate for
# both spl.com.au and www.spl.com.au (cPanel > SSL/TLS Status). Canonical host: {{HOST}}
# RewriteCond %{HTTPS} !=on [OR]
# RewriteCond %{HTTP_HOST} ^{{OTHER_HOST_ESC}}$ [NC]
# RewriteRule ^ https://{{HOST}}%{REQUEST_URI} [R=301,L,NE]

# --- Contact form endpoint (forms.js posts to /api/contact) -------------------
RewriteRule ^api/contact/?$ api/contact.php [L]

# --- 301 redirects: old splsecurity.com.au paths (on this host) (seo.config.json + backlink-migration.csv)
{{REDIRECTS}}

# --- Old ballinalocksmiths.com.au domain (only active if that domain is pointed/parked on this account)
{{BALLINA}}

# --- Old splsecurity.com.au domain -> spl.com.au, same path (only active if that domain is parked/aliased here)
RewriteCond %{HTTP_HOST} ^(www\.)?splsecurity\.com\.au$ [NC]
RewriteRule ^ https://{{HOST}}%{REQUEST_URI} [R=301,L,NE]
</IfModule>

# --- Staging: keep search engines out until launch ------------------------------
{{STAGING}}

# --- Security headers ------------------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "geolocation=(), camera=(), microphone=()"
  # Enable after HTTPS works on both hosts:
  # Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

# Block dotfiles (except .well-known for AutoSSL) and backup/source files
<IfModule mod_rewrite.c>
  RewriteRule (^|/)\.(?!well-known/) - [F]
</IfModule>
<FilesMatch "\.(bak|orig|log|sql|sh|md|cjs|lock)$">
  Require all denied
</FilesMatch>

# --- Compression --------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/javascript application/json application/manifest+json image/svg+xml font/ttf
</IfModule>

# --- Caching ------------------------------------------------------------------------
# HTML revalidates; CSS/JS are versioned with ?v=; images and fonts are long-lived.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/xml "access plus 1 hour"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/manifest+json "access plus 1 week"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(css|js|webp|png|jpe?g|svg|ico|woff2)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
</IfModule>
AddType font/woff2 .woff2
AddType application/manifest+json .webmanifest
AddType image/webp .webp
